# SCCM Patching API settings - TEMPLATE (placeholders only).
#
# Copy this file OUTSIDE the project folder, fill it in, and lock it down:
#   New-Item -ItemType Directory "$env:USERPROFILE\.sccm-api" -Force
#   Copy-Item .\sccm-api.env.example "$env:USERPROFILE\.sccm-api\sccm-api.env"
#   notepad "$env:USERPROFILE\.sccm-api\sccm-api.env"
#   icacls "$env:USERPROFILE\.sccm-api\sccm-api.env" /inheritance:r /grant:r "$($env:USERNAME):F"
#
# The API reads %USERPROFILE%\.sccm-api\sccm-api.env, or the file named in SCCM_ENV_FILE.
# It refuses to start if the file is inside the project folder.
# Format: NAME=value, one per line. No inline comments (passwords may contain #).
# Quotes around the whole value are optional and removed.

# --- Required ---------------------------------------------------------------
SCCM_API_KEY=<long-random-secret>
# Jumphost login (SCCMAutomation endpoint on ORDPGBLWTS21)
SCCM_USERNAME=GLOBAL\svc_patching_auto1
SCCM_PASSWORD=<password>

# --- Folder of the Automation scripts on the jumphost -----------------------
SCCM_PROJECT_ROOT=C:\SCCM_Automation

# --- Deployments (leave false until the SCCM admin has authorised writes) ---
SCCM_ALLOW_DEPLOYMENT=false

# --- Server selection from Active Directory -----------------------------------
# Domains the UI may list servers from (comma separated; Get-ADServers.ps1 on the jumphost).
SCCM_AD_DOMAINS=dslab.ad.adp.com
# Most servers one prerequisite run or deployment may target.
SCCM_MAX_SERVERS_PER_RUN=50

# --- Optional: admin key for POST /api/sccm/deployments/release-lock ---------
# Not set: the normal API key is enough.
SCCM_ADMIN_API_KEY=<another-long-random-secret>

# --- Optional: admin account on the target servers (KB checks, restarts) ----
# Leave both empty to use the DSLAB account below for the servers.
SCCM_TARGET_USERNAME=
SCCM_TARGET_PASSWORD=

# --- DSLAB jumphost (server validation from inside DSLAB) -------------------
SCCM_DSLAB_USERNAME=dslab\svc_patching_auto1
SCCM_DSLAB_PASSWORD=<password>

# --- Optional overrides -------------------------------------------------------
# SCCM_JUMPHOST=ORDPGBLWTS21.global.cdk.com
# SCCM_SITE_SERVER=ORDPGBLSCCM11.global.cdk.com
# SCCM_SITE_CODE=T01
# SCCM_SESSION_CONFIG=SCCMAutomation
# SCCM_DSLAB_JUMPHOST=ordpdslwts01.dslab.ad.adp.com
# SCCM_DSLAB_AUTH=Negotiate
# SCCM_JOB_DB=C:\SCCM_API\jobs.db
# SCCM_DEPLOY_TIMEOUT_HOURS=12
# SCCM_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Never prompt in the terminal for missing values:
SCCM_NO_PROMPT=true
