      "name": "01 Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "02 Connection test",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const job = pm.response.json();",
              "if (job.job_id) { pm.collectionVariables.set('jobId', job.job_id); pm.collectionVariables.set('logAfter', '-1'); }",
              "if (pm.response.code === 409 && job.detail && job.detail.message) pm.test('LOCKED: ' + job.detail.message, () => true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          }
        ],
        "url": "{{baseUrl}}/api/sccm/connection-test"
      }
    },
    {
      "name": "03 Environment check",
