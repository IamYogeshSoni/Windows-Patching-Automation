        ],
        "url": "{{baseUrl}}/api/sccm/dry-run/continue",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"run_id\": \"{{runId}}\",\n  \"sug_id\": \"{{sugId}}\",\n  \"collection_id\": \"{{collectionId}}\"\n}"
        }
      }
    }
  ]
}
