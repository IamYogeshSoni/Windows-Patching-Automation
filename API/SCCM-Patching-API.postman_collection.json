{
  "info": {
    "name": "SCCM Patching API v4",
    "description": "Run in numbered order. Every POST returns a job; keep sending '05 Get job' until status is SUCCEEDED, COMPLETED_WITH_ISSUES, FAILED or OUTCOME_UNKNOWN. Each 05 response contains the new log lines (log[]); logAfter moves forward automatically. See API-Testing.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "adminKey",
      "value": ""
    },
    {
      "key": "user",
      "value": "Your Name"
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "logAfter",
      "value": "-1"
    },
    {
      "key": "precheckJobId",
      "value": ""
    },
    {
      "key": "sugId",
      "value": ""
    },
    {
      "key": "collectionId",
      "value": ""
    },
    {
      "key": "newCollectionName",
      "value": "Patch Oct 2026 - DSLAB test"
    },
    {
      "key": "deploymentName",
      "value": "Patch Testing Oct 2026"
    },
    {
      "key": "windowStartUtc",
      "value": "2026-10-20T06:00:00Z"
    },
    {
      "key": "deadlineUtc",
      "value": "2026-10-20T06:30:00Z"
    },
    {
      "key": "reportFolder",
      "value": ""
    },
    {
      "key": "lockJobId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    }
  ],
  "item": [
