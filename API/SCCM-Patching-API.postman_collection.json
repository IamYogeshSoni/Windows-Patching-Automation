    {
      "name": "04 Prerequisites",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const job = pm.response.json();",
              "if (job.job_id) { pm.collectionVariables.set('jobId', job.job_id); pm.collectionVariables.set('logAfter', '-1'); }",
              "if (pm.response.code === 409 && job.detail && job.detail.message) pm.test('LOCKED: ' + job.detail.message, () => true);",
              "if (job.job_id) pm.collectionVariables.set('precheckJobId', job.job_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          }
        ],
        "url": "{{baseUrl}}/api/sccm/prerequisites"
      }
    },
    {
      "name": "05 Get job + new log lines (waits up to 60s)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const job = pm.response.json();",
              "if (job.log_next !== undefined) pm.collectionVariables.set('logAfter', String(job.log_next));",
              "const r = job.result || {};",
              "if (job.kind === 'sugs' && job.status === 'SUCCEEDED' && !pm.collectionVariables.get('sugId')) {",
              "  const s = [].concat(r.sugs || []); if (s.length) pm.collectionVariables.set('sugId', s[0].id);",
              "}",
              "if (job.kind === 'inventory' && job.status === 'SUCCEEDED') {",
              "  const s = [].concat(r.sugs || []), c = [].concat(r.collections || []);",
              "  pm.collectionVariables.set('runId', job.job_id);",
              "  if (!pm.collectionVariables.get('sugId') && s.length) pm.collectionVariables.set('sugId', s[0].id);",
              "  if (!pm.collectionVariables.get('collectionId') && c.length) pm.collectionVariables.set('collectionId', c[0].id);",
              "}",
              "if (r.report_folder_name && job.kind !== 'prerequisites') pm.collectionVariables.set('reportFolder', r.report_folder_name);",
              "if (r.selectable_servers) console.log('READY servers:', JSON.stringify(r.selectable_servers));",
              "(job.log || []).forEach(l => console.log(l.line));",
              "pm.test('status: ' + job.status + ' | log lines: ' + job.log_lines + (r.report_headline ? ' | ' + r.report_headline : ''), () => true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/jobs/{{jobId}}?wait=60&log_after={{logAfter}}"
      }
    },
