# Copy to .env.local and fill in. .env.local is read by `npm run dev` / `npm run preview`.

# Where the SCCM Patching API (API\app.py) runs. The UI calls /sccm-api/... and
# the Vite server forwards it here, so no CORS setup is needed.
SCCM_API_TARGET=http://127.0.0.1:8000

# Must equal SCCM_API_KEY in API\.env.
VITE_SCCM_API_KEY=

# Optional: name sent as X-User and recorded as requested_by on jobs and in the audit log.
VITE_SCCM_USER=

# Optional: call the API directly instead of through the Vite proxy (the API's
# SCCM_CORS_ORIGINS must then include the UI's origin).
# VITE_SCCM_API_URL=http://127.0.0.1:8000
